# Copie como clouds.env y reemplace IPs, usuarios y rutas de las llaves SSH.
# Formato: nombre|usuario@ip|llave_ssh|origen|región|tipo_vm
# (clouds.env está en .gitignore: nunca suba IPs ni llaves al repositorio)
# Para DonWeb (SSH en otro puerto) agregue en ~/.ssh/config:  Host IP_LATAM  Port 5349
usa|ubuntu@IP_USA|~/.ssh/aws.pem|EE.UU.|us-east-2 Ohio|m7i-flex.large
china|root@IP_CHINA|~/.ssh/alibaba.pem|Singapur|ap-southeast-1|ecs.c9i.xlarge
europa|ubuntu@IP_EUROPA|~/.ssh/ovh.pem|Alemania|DE1 Fráncfort|b3-16
latam|root@IP_LATAM|~/.ssh/donweb.pem|Argentina|Buenos Aires|Cloud Server
ecuador|root@IP_ECUADOR|~/.ssh/telecu.pem|Ecuador|Quito|TPX01
