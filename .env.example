# Copie este archivo como .env (cp .env.example .env) y ajuste los valores.
# Imagen publicada por GitHub Actions (reemplace TU_USUARIO por su usuario de GitHub, en minúsculas)
IMAGE=ghcr.io/TU_USUARIO/adn-multicloud:latest

# Datos de la nube donde se ejecuta (aparecen en el JSON de resultados)
CLOUD_PROVIDER=local
CLOUD_ORIGIN=Ecuador
CLOUD_REGION=mi-laptop
INSTANCE_TYPE=laptop

# Fuente del ADN
# - Genoma real del docente (Dropbox, enlace del ARCHIVO, no de la carpeta).
#   Déjelo vacío para usar ADN sintético.
DNA_URL=
# 0 = archivo completo; ej. 200 = solo los primeros 200 MB (pruebas rápidas)
DNA_LIMIT_MB=0

# Parámetros del experimento
# DNA_SIZE solo se usa con ADN sintético (cuando DNA_URL está vacío)
DNA_SIZE=100MB
SEED=2026
MODE=both
WORKERS=0
CHUNK_MB=32
PATTERN=GATTACA
